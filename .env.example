# SETU configuration — copy to .env and adjust. Core runs fully local; no keys required.

# LLM served by local Ollama
SETU_LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434

# Models (Hugging Face IDs — all open-source)
SETU_EMBED_MODEL=BAAI/bge-m3
SETU_NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
SETU_ASR_MODEL=large-v3-turbo
SETU_MT_INDIC_EN=ai4bharat/indictrans2-indic-en-dist-200M
SETU_MT_EN_INDIC=ai4bharat/indictrans2-en-indic-dist-200M
SETU_TTS_MODEL=ai4bharat/IndicF5

# Paths
SETU_DB_PATH=data/setu.db
SETU_INDEX_DIR=data/processed
